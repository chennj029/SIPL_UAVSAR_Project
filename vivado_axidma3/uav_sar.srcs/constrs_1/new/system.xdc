set_property PACKAGE_PIN B1 [get_ports {adc_data[6]}]
set_property PACKAGE_PIN B4 [get_ports {adc_data[5]}]
set_property PACKAGE_PIN A4 [get_ports {adc_data[4]}]
set_property PACKAGE_PIN B3 [get_ports {adc_data[3]}]
set_property PACKAGE_PIN A3 [get_ports {adc_data[2]}]
set_property PACKAGE_PIN A2 [get_ports {adc_data[1]}]
set_property PACKAGE_PIN A1 [get_ports {adc_data[0]}]

