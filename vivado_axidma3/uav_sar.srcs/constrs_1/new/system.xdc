################## Compress Bitstream ##################
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]

#define main clock, period 10 ns, duty cycle 50%
create_clock -period 200.000 [get_ports adc_clk]
#set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets {adc_clk_IBUF[0]_inst/O}]

#constrain method 1, set main clock as source
create_generated_clock -name triggle -source [get_ports adc_clk] -divide_by 5000 [get_ports triggle]

#constrain method 2, set pin of REGA as source
#create_generated_clock -name sample_en -source [get_pins REGA/C] -divide_by 2 [get_pins REGA/Q]

################## PL Pins Constrains ##################
# HMC703 Triggle
set_property PACKAGE_PIN F12 [get_ports triggle]
set_property IOSTANDARD LVCMOS33 [get_ports triggle]
# Trigger Source Select
set_property PACKAGE_PIN B14 [get_ports trig_sel]
set_property IOSTANDARD LVCMOS33 [get_ports trig_sel]
# AD9269 DCO Indicator
set_property PACKAGE_PIN AE12 [get_ports led]
set_property IOSTANDARD LVCMOS33 [get_ports led]
# External Trigger
set_property PACKAGE_PIN D12 [get_ports ext_trig]
set_property IOSTANDARD LVCMOS33 [get_ports ext_trig]

# AD9269 DCOA
set_property PACKAGE_PIN D7 [get_ports {adc_clk[0]}]
set_property IOSTANDARD LVCMOS18 [get_ports {adc_clk[0]}]
# AD9269 BUF_DA
set_property PACKAGE_PIN K9 [get_ports {adc_data[15]}]
set_property PACKAGE_PIN J9 [get_ports {adc_data[14]}]
